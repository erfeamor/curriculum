# OS / editor
.DS_Store
*.swp
.vscode/
.idea/

# Claude Code: personal settings and the local dev-loop adapter stay local (the
# adapter binds this checkout to a dev-loop engine only installed in ~/.claude).
# Only the shared task board is tracked — its state, including dev-loop updates.
.claude/*
!.claude/tasks/

# Per-task QA stacks generated by scripts/qa-env-override.py (ephemeral)
docker-compose.override.cvdl_*.yml
__pycache__/

# The sibling product repos are cloned locally by clone-all.sh but are not
# part of this meta repo's own history.
cv-database/
cv-domain-service/
cv-bff-node/
cv-admin-react/
cv-public-vanilla/
cv-public-react/
cv-observability/
cv-infra/
